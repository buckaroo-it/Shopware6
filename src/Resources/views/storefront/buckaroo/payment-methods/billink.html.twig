{% block buckaroo_payment_method_billink %}
    {% if page.extensions.buckaroo.BillinkBusiness == 'B2B' %}
        <div class="payment-method-second-col billing-address-form">
            <fieldset class="fieldset payment">
                <div class="form-group">
                    <label class="form-label" for="buckaroo_billink_coc">
                        {{ "buckaroo.checkout.cOCNumber"|trans }}*
                    </label>
                    <input type="text"
                           class="form-control"
                           form="confirmOrderForm"
                           id="buckaroo_billink_coc"
                           name="buckaroo_billink_coc"
                           placeholder="{{ "buckaroo.checkout.CocPlaceholder"|trans|striptags }}"
                           required="required">
                    <label class="form-label" style="display:none; color:red" for="buckaroo_billink_coc" id="buckarooCocError">
                        {{ "buckaroo.checkout.buckarooMobileCocError"|trans|sw_sanitize }}
                    </label>
                </div>
            </fieldset>
        </div>
    {% endif %}
{% endblock %}
