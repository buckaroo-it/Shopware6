{% block buckaroo_payment_method_creditcards %}
    {% if page.extensions.buckaroo.creditcards|length > 0 %}

        {#
            Buckaroo Credit Card Hosted Fields.

            Every card input is an <iframe> served by Buckaroo, so the Storefront
            cannot style the input itself. Each wrapper below is therefore a real
            Storefront .form-control that carries the visible chrome (border,
            radius, height, padding, focus and invalid state) while the field
            inside the iframe is styled through the SDK's baseStyling API, which
            the storefront JS derives from this wrapper's computed style.
            See buckaroo-payment.creditcard.js and scss/_hosted-fields.scss.
        #}
        <div class="bk-hosted-fields" id="bk-hosted-fields-creditcards" data-buckaroo-hosted-fields="true">

            {# Filled by the SDK on submit and posted with the confirm order form. #}
            <input type="hidden" id="buckaroo-token" name="buckaroo-token" form="confirmOrderForm">
            <input type="hidden" id="selected-issuer" name="selected-issuer" form="confirmOrderForm">

            <div class="buckaroo-hf-error invalid-feedback mb-3" role="alert"></div>

            <div class="form-group">
                <label class="form-label" id="cc-name-label">Cardholder Name</label>
                <div class="form-control bk-hosted-field"
                     id="cc-name-wrapper"
                     role="group"
                     aria-labelledby="cc-name-label"
                     aria-describedby="cc-name-error"></div>
                <div class="invalid-feedback" id="cc-name-error" role="alert"></div>
            </div>

            <div class="form-group">
                <label class="form-label" id="cc-number-label">Card Number</label>
                <div class="form-control bk-hosted-field"
                     id="cc-number-wrapper"
                     role="group"
                     aria-labelledby="cc-number-label"
                     aria-describedby="cc-number-error"></div>
                <div class="invalid-feedback" id="cc-number-error" role="alert"></div>
            </div>

            <div class="row g-3">
                <div class="col-6">
                    <div class="form-group">
                        <label class="form-label" id="cc-expiry-label">Expiry Date</label>
                        <div class="form-control bk-hosted-field"
                             id="cc-expiry-wrapper"
                             role="group"
                             aria-labelledby="cc-expiry-label"
                             aria-describedby="cc-expiry-error"></div>
                        <div class="invalid-feedback" id="cc-expiry-error" role="alert"></div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-group">
                        <label class="form-label" id="cc-cvc-label">CVC</label>
                        <div class="form-control bk-hosted-field"
                             id="cc-cvc-wrapper"
                             role="group"
                             aria-labelledby="cc-cvc-label"
                             aria-describedby="cc-cvc-error"></div>
                        <div class="invalid-feedback" id="cc-cvc-error" role="alert"></div>
                    </div>
                </div>
            </div>

            <div class="bk-hosted-fields-actions">
                <button id="pay" class="btn btn-primary" type="button">Submit</button>
                <a class="bk-hosted-fields-cancel" href="#">Cancel</a>
            </div>
        </div>

    {% endif %}
{% endblock %}
