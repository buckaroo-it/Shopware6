{% block buckaroo_payment_method_bancontactmrcash %}

    {#
        Buckaroo Bancontact Hosted Fields.

        Same markup and styling as the card Hosted Fields (creditcards.html.twig),
        without a CVC: Bancontact cards have no security code. See
        bancontact/buckaroo-payment.bancontact.js and scss/_hosted-fields.scss.
    #}
    <div class="bk-hosted-fields" id="bk-hosted-fields-bancontactmrcash" data-buckaroo-hosted-fields="true">

        {# Filled by the SDK on submit and posted with the confirm order form. #}
        <input type="hidden" id="buckaroo-token" name="buckaroo-token" form="confirmOrderForm">
        <input type="hidden" id="selected-issuer" name="selected-issuer" form="confirmOrderForm">

        <div class="buckaroo-hf-error invalid-feedback mb-3" role="alert"></div>

        <div class="form-group">
            <label class="form-label" id="bc-name-label">{{ "buckaroo.checkout.bancontactmrcash.cardholder"|trans }}</label>
            <div class="form-control bk-hosted-field"
                 id="bc-name-wrapper"
                 role="group"
                 aria-labelledby="bc-name-label"
                 aria-describedby="bc-name-error"></div>
            <div class="invalid-feedback" id="bc-name-error" role="alert"></div>
        </div>

        <div class="form-group">
            <label class="form-label" id="bc-number-label">{{ "buckaroo.checkout.bancontactmrcash.cardNumber"|trans }}</label>
            <div class="form-control bk-hosted-field"
                 id="bc-number-wrapper"
                 role="group"
                 aria-labelledby="bc-number-label"
                 aria-describedby="bc-number-error"></div>
            <div class="invalid-feedback" id="bc-number-error" role="alert"></div>
        </div>

        <div class="row g-3">
            <div class="col-6">
                <div class="form-group">
                    <label class="form-label" id="bc-expiry-label">{{ "buckaroo.checkout.bancontactmrcash.expiration"|trans }}</label>
                    <div class="form-control bk-hosted-field"
                         id="bc-expiry-wrapper"
                         role="group"
                         aria-labelledby="bc-expiry-label"
                         aria-describedby="bc-expiry-error"></div>
                    <div class="invalid-feedback" id="bc-expiry-error" role="alert"></div>
                </div>
            </div>
        </div>

        <div class="bk-hosted-fields-actions">
            <button id="pay" class="btn btn-primary" type="button">Submit</button>
            <a class="bk-hosted-fields-cancel" href="#">Cancel</a>
        </div>
    </div>

{% endblock %}
