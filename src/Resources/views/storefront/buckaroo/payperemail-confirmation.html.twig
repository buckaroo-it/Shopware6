{% sw_extends '@Storefront/storefront/base.html.twig' %}

{% block base_content %}
  <div class="bkr-payperemail my-5">
    <div class="bkr-card">
      <div class="bkr-card-body text-center">
        <div class="bkr-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 16 16" fill="currentColor">
            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
            <path d="M10.97 4.97a.235.235 0 0 0-.02.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05z"/>
          </svg>
        </div>

        <div class="bkr-title">{{ 'buckaroo.payperemail.thank_you'|trans|default('Thank you for your payment!') }}</div>
        <div class="bkr-subtitle">{{ 'buckaroo.payperemail.payment_received'|trans|default('Your payment has been received and your order is being processed.') }}</div>

        <div class="bkr-badge">
          <strong>{{ 'buckaroo.payperemail.order_number'|trans|default('Order number') }}:</strong> {{ orderNumber }}
        </div>

        <div class="bkr-subtitle">{{ 'buckaroo.payperemail.confirmation_email'|trans|default('A confirmation email will be sent to you shortly with the order details.') }}</div>

        <div class="bkr-actions">
          {% if orderDeepLink %}
            <a class="btn btn-primary" href="{{ path('frontend.account.order.single.page', { 'deepLinkCode': orderDeepLink }) }}">{{ 'buckaroo.payperemail.view_order'|trans|default('View Order Details') }}</a>
          {% endif %}
          <a class="btn btn-outline-primary" href="{{ path('frontend.home.page') }}">{{ 'buckaroo.payperemail.continue_shopping'|trans|default('Continue Shopping') }}</a>
        </div>
      </div>
    </div>
  </div>
{% endblock %}

