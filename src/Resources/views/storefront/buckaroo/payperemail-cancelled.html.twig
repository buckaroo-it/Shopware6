{% sw_extends '@Storefront/storefront/base.html.twig' %}

{% block base_content %}
  <div class="bkr-payperemail my-5">
    <div class="bkr-card">
      <div class="bkr-card-body text-center">
        <div class="bkr-icon bkr-icon--warning">
          <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 16 16" fill="currentColor">
            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
            <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"/>
          </svg>
        </div>

        <div class="bkr-title">{{ 'buckaroo.payperemail.payment_cancelled'|trans|default('Payment Cancelled') }}</div>
        <div class="bkr-subtitle">{{ 'buckaroo.payperemail.payment_not_completed'|trans|default('The payment was not completed. Your order is still pending.') }}</div>

        <div class="bkr-badge bkr-badge--warning">
          <strong>{{ 'buckaroo.payperemail.order_number'|trans|default('Order number') }}:</strong> {{ orderNumber }}
        </div>

        <div class="bkr-subtitle">{{ 'buckaroo.payperemail.can_retry'|trans|default('You can complete the payment later from your account or contact us for assistance.') }}</div>

        <div class="bkr-actions">
          <a class="btn btn-primary" href="{{ path('frontend.home.page') }}">{{ 'buckaroo.payperemail.back_to_shop'|trans|default('Back to Shop') }}</a>
        </div>
      </div>
    </div>
  </div>
{% endblock %}

