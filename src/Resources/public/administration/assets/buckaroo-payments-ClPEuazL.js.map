<div
    class="bk-toggle-status"
    role="group"
    :aria-label="$t('buckaroo-payment.paymentList.toggleLabel', { name: label })"
>
    <span
        v-for="option in options"
        :key="option"
        class="bk-toggle-status__option-wrap"
        v-tooltip="{
            message: $t('buckaroo-payment.paymentList.testUnavailable', { parent: sharedEnvironmentLabel }),
            disabled: !(option === 'test' && isTestUnavailable)
        }"
    >
        <button
            type="button"
            class="bk-toggle-status__option"
            :class="[`is--${option}`, { 'is--selected': status === option }]"
            :aria-pressed="status === option ? 'true' : 'false'"
            :disabled="isOptionDisabled(option)"
            @click="setStatus(option)"
        >
            {{ $tc(`buckaroo-payment.paymentList.${option}`) }}
        </button>
    </span>
</div>
