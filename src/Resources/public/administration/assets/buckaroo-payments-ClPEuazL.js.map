<sw-card
    class="bk-payment-list"
    position-identifier="bk-config-payment-list"
    :title="$tc('buckaroo-payment.payment-methods')"
>
    <p class="bk-payment-list__summary">
        {{ $t('buckaroo-payment.paymentList.summary', { active: activeCount, total: payments.length }) }}
    </p>

    <div class="bk-payment-list__grid">
        <div
            v-for="payment in sortedPayments"
            :key="payment.code"
            class="bk-payment-tile"
        >
            <router-link
                class="bk-payment-tile__body"
                :to="configRoute(payment.code)"
                :title="$tc('buckaroo-payment.configure-payment')"
            >
                <span class="bk-payment-tile__logo">
                    <img
                        :src="assetFilter(`buckaroopayments/images/${payment.logo}`)"
                        alt=""
                    >
                </span>

                <span class="bk-payment-tile__name">
                    {{ payment.title }}
                </span>
            </router-link>

            <div
                v-if="getAvailabilityIssue(payment.code)"
                class="bk-payment-tile__warning"
                role="status"
            >
                <span
                    class="bk-payment-tile__warning-title"
                    v-tooltip="$tc(`buckaroo-payment.paymentList.availability.${getAvailabilityIssue(payment.code)}`)"
                >
                    <sw-icon
                        name="regular-exclamation-triangle"
                        size="12px"
                    />
                    {{ $tc('buckaroo-payment.paymentList.availability.title') }}
                </span>

                <router-link
                    v-if="getAvailabilityIssue(payment.code) === 'inactive'"
                    class="bk-payment-tile__warning-action"
                    :to="paymentSettingsRoute(payment.code)"
                >
                    {{ $tc('buckaroo-payment.paymentList.availability.openSettings') }}
                </router-link>

                <button
                    v-else-if="canAssignSalesChannels()"
                    type="button"
                    class="bk-payment-tile__warning-action"
                    @click="openAssignModal(payment)"
                >
                    {{ $tc('buckaroo-payment.paymentList.availability.assign') }}
                </button>
            </div>

            <div class="bk-payment-tile__footer">
                <buckaroo-toggle-status
                    :currentSalesChannelId="currentSalesChannelId"
                    :method="payment.code"
                    :label="payment.title"
                    :sharedEnvironmentLabel="getSharedEnvironmentTitle(payment.code)"
                    :value="value"
                    @input="$emit('input', $event)"
                />

                <router-link
                    class="bk-payment-tile__configure"
                    :to="configRoute(payment.code)"
                    :aria-label="$tc('buckaroo-payment.configure-payment')"
                    v-tooltip="$tc('buckaroo-payment.configure-payment')"
                >
                    <sw-icon
                        name="regular-cog"
                        size="16px"
                    />
                </router-link>
            </div>
        </div>
    </div>

    <buckaroo-sales-channel-modal
        v-if="assignModalPayment"
        :payment-method-id="paymentMethodsByCode[assignModalPayment.code].id"
        :payment-title="assignModalPayment.title"
        :sales-channels="salesChannels"
        :assigned-sales-channel-ids="paymentMethodsByCode[assignModalPayment.code].salesChannelIds"
        @close="closeAssignModal"
        @saved="onAssignSaved"
    />
</sw-card>
