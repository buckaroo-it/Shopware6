{
    "name": "buckaroo/shopware6",
    "description": "Buckaroo payment provider plugin for Shopware 6",
    "type": "shopware-platform-plugin",
    "version": "3.4.0",
    "license": "proprietary",
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-pcre": "*",
        "ext-fileinfo": "*",
        "buckaroo/sdk": "^1.23.2",
        "shopware/core": ">=6.5.8.0 <6.8"
    },
    "authors": [
        {
            "name": "Buckaroo",
            "email": "support@buckaroo.nl",
            "homepage": "https://www.buckaroo.nl",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Buckaroo\\Shopware6\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Buckaroo\\Shopware6\\Tests\\": "tests/"
        }
    },
    "extra": {
        "shopware-plugin-class": "Buckaroo\\Shopware6\\BuckarooPayments",
        "plugin-icon": "src/Resources/public/plugin.png",
        "copyright": "(c) by Buckaroo",
        "label": {
            "de-DE": "Buckaroo Payment",
            "en-GB": "Buckaroo Payment"
        },
        "description": {
            "de-DE": "Buckaroo Payment Plugins",
            "en-GB": "Buckaroo Payment Plugin"
        },
        "manufacturerLink": {
            "de-DE": "https://store.shopware.com/buckaroo.html",
            "en-GB": "https://store.shopware.com/en/buckaroo.html"
        },
        "supportLink": {
            "de-DE": "https://support.buckaroo.nl/contact",
            "en-GB": "https://support.buckaroo.nl/contact"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "*",
        "phpstan/phpstan": "^1.9",
        "shopware/storefront": "*",
        "shopware/administration": "*",
        "deployer/deployer": "^7.3"
    },
    "scripts": {
        "phpcs": [
            "vendor/bin/phpcs ./"
        ],
        "phpstan": [
            "vendor/bin/phpstan analyze"
        ]
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "policy": {
            "advisories": {
                "ignore-id": {
                    "CVE-2026-53965": "CVE-2026-53965 (mcp/sdk unbounded SSE buffer in the MCP *client* HTTP transport). shopware/core 6.7.13.0 is the first release to require mcp/sdk and pins ^0.6.0, while the fix landed only in 0.7.1 - so Composer 2.10+ blocks 6.7.13 outright. Not exploitable here: the MCP server is opt-in via MCP_SERVER=1 and is not enabled. REMOVE this entry once Shopware ships a patch bumping mcp/sdk to ^0.7.1."
                }
            }
        }
    }
}
